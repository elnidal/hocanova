// Cloudflare Workers statik yayın: dist/ klasörü lgsingilizce.app'te. Yayın: npm run deploy
{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "lgsingilizce",
  "account_id": "3e4cd5344221f1d1ccea09776236ef38",
  "routes": [
    { "pattern": "lgsingilizce.app", "custom_domain": true },
    { "pattern": "www.lgsingilizce.app", "custom_domain": true }
  ],
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
